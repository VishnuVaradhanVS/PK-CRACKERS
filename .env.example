# Email delivery options:
# Render Free: set EMAIL_PROVIDER= and RESEND_API_KEY.
# Local development: leave EMAIL_PROVIDER blank to print emails to the console.
# SMTP: set EMAIL_PROVIDER=smtp and the SMTP values below (paid Render or local only).
EMAIL_PROVIDER=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Optional legacy SMTP configuration (used only when EMAIL_PROVIDER=smtp).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Meta WhatsApp Cloud API (optional; create and approve the templates before enabling).
WHATSAPP_ENABLED=False
WHATSAPP_NOTIFY_CUSTOMERS=True
WHATSAPP_NOTIFY_ADMINS=True
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=kk_order_confirmation
WHATSAPP_TEMPLATE_ORDER_UPDATE=kk_order_update
WHATSAPP_TEMPLATE_ADMIN_NEW_ORDER=kk_admin_new_order
